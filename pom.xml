<?xml version="1.0" encoding="UTF-8"?>
<!--
  OfficeHQ — a Spring Boot app. The UI is server-rendered HTML (Thymeleaf, with htmx); pages are
  Spring MVC @Controller methods. H2 + Flyway + Actuator. No Node toolchain: htmx is a single
  vendored file under src/main/resources/static.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Standard Spring Boot app parent (4.1.0). -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>net.officefloor.hq</groupId>
  <artifactId>officehq-app</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <!-- Pages and fragments are Spring MVC @Controller methods. -->
    <!-- Spring Boot hosts: web (HTTP server), data-jpa (H2 access), actuator (health probe). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Server-rendered HTML: @Controller methods return a template name; templates live in
         src/main/resources/templates. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bean Validation provider (Hibernate Validator) — bind + @Valid. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- In-memory H2 + Flyway schema migrations on boot (Spring-managed). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- REQUIRED under Spring Boot 4: FlywayAutoConfiguration was extracted from
         spring-boot-autoconfigure into this module. Without it, flyway-core is on the classpath but
         migrations NEVER run on boot (silently). Version managed by the parent BOM. flyway-core 12.x
         has H2 support built in, so no flyway-database-h2 module is needed. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- No front-end build: pages are Thymeleaf templates served from the jar; htmx is a single
           vendored file under src/main/resources/static. -->
      <!-- Standard Spring Boot executable jar (main = the @SpringBootApplication class). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>net.officefloor.hq.app.Application</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
