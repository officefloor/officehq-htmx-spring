# Build output.
target/
*.jar
node_modules/
.run/
# static/ is NOT build output here — it holds vendored assets (htmx) that must be committed
# (served from the jar; the build and tests run with no network egress).

# Playwright
e2e/test-results/
e2e/playwright-report/
# Test specs are provided at run time; keep them out of version control.
e2e/specs/*
!e2e/specs/.gitkeep
/.idea/

# No Node toolchain in this stack: pages are Thymeleaf templates, not a built SPA.
